# .env.example
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# SECURITY NOTE: none of these variables may ever be prefixed with NEXT_PUBLIC_.
# That prefix tells Next.js to bundle the value into client-side JavaScript, which would
# ship your API keys to every browser that loads the page. All AI provider calls in this
# project happen inside src/app/api/visioninspect/route.ts and the adapters it calls,
# which run only on the server.

# --- Gemini (primary vision analysis provider) ---
# Get a key from https://ai.google.dev/ — used for multimodal image analysis and
# structured-output defect hypotheses.
GEMINI_API_KEY=

# --- Groq (fallback provider, text-only) ---
# Get a key from https://console.groq.com/ — used only when Gemini fails or times out.
# Groq cannot re-analyze the image itself; the fallback path returns a degraded-confidence
# response and says so explicitly. See src/lib/visioninspect/adapters/groq-fallback.adapter.ts
GROQ_API_KEY=

# --- Application limits ---
# Maximum accepted upload size in bytes. Enforced server-side before any provider call.
# Default: 8388608 (8 MB)
MAX_UPLOAD_BYTES=8388608

# Requests allowed per identifier (IP) within the rate-limit window.
# See src/lib/visioninspect/rate-limit.ts — this is an in-memory stub suitable for a
# single-instance deployment; replace with a persistent store (e.g. Upstash Redis) before
# any real multi-instance production use.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# --- Report storage ---
# Directory where confirmed inspection reports are written as JSON files.
# This is a file-based adapter suitable for local development and small pilots.
# Relative to the project root.
REPORT_STORAGE_DIR=.data/reports
